{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",

      "Bash(node --version)",
      "Bash(node -v)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm run:*)",
      "Bash(npm ls:*)",
      "Bash(npm list:*)",
      "Bash(npm view:*)",
      "Bash(npm outdated:*)",
      "Bash(npm --version)",
      "Bash(npx:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm i:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm ls:*)",
      "Bash(pnpm dlx:*)",
      "Bash(pnpm --version)",

      "Bash(tsc --noEmit:*)",
      "Bash(tsc --version)",
      "Bash(vite:*)",
      "Bash(eslint:*)",
      "Bash(prettier --check:*)",
      "Bash(prettier --write:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git remote:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git config --get:*)",
      "Bash(git config --list:*)",

      "PowerShell(node --version)",
      "PowerShell(node -v)",
      "PowerShell(npm install:*)",
      "PowerShell(npm i:*)",
      "PowerShell(npm run:*)",
      "PowerShell(npm ls:*)",
      "PowerShell(npm list:*)",
      "PowerShell(npm view:*)",
      "PowerShell(npm outdated:*)",
      "PowerShell(npm --version)",
      "PowerShell(npx:*)",
      "PowerShell(pnpm install:*)",
      "PowerShell(pnpm i:*)",
      "PowerShell(pnpm run:*)",
      "PowerShell(pnpm ls:*)",
      "PowerShell(pnpm dlx:*)",
      "PowerShell(pnpm --version)",

      "PowerShell(tsc --noEmit:*)",
      "PowerShell(tsc --version)",
      "PowerShell(vite:*)",
      "PowerShell(eslint:*)",
      "PowerShell(prettier --check:*)",
      "PowerShell(prettier --write:*)",

      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git branch:*)",
      "PowerShell(git show:*)",
      "PowerShell(git remote:*)",
      "PowerShell(git fetch:*)",
      "PowerShell(git rev-parse:*)",
      "PowerShell(git ls-files:*)",
      "PowerShell(git config --get:*)",
      "PowerShell(git config --list:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch --delete:*)",
      "Bash(git checkout --:*)",
      "Bash(git restore --:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",

      "PowerShell(Remove-Item -Recurse:*)",
      "PowerShell(Remove-Item -Force:*)",
      "PowerShell(git push:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git clean:*)",
      "PowerShell(git branch -D:*)",
      "PowerShell(git branch --delete:*)",
      "PowerShell(git checkout --:*)",
      "PowerShell(git restore --:*)",
      "PowerShell(npm publish:*)",
      "PowerShell(pnpm publish:*)"
    ]
  }
}
